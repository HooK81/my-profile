{
    "type": "project",
    "name": "hook81/my_profile_api",
    "description": "My Profile API",
    "version": "2.0.0",
    "license": "proprietary",
    "keywords": [
        "profile",
        "resume",
        "cv"
    ],
    "require": {
        "php": "^8.1.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "friendsofsymfony/jsrouting-bundle": "^2.5",
        "friendsofsymfony/rest-bundle": "^3.0",
        "lexik/jwt-authentication-bundle": "^2.12",
        "ramsey/uuid": "^4.3",
        "sabre/vobject": "^4.4",
        "sensio/framework-extra-bundle": "^6.2",
        "symfony/console": "5.4.*",
        "symfony/dotenv": "5.4.*",
        "symfony/error-handler": "5.4.*",
        "symfony/flex": "^1.3.1",
        "symfony/form": "5.4.*",
        "symfony/framework-bundle": "5.4.*",
        "symfony/http-client": "5.4.*",
        "symfony/mailer": "5.4.*",
        "symfony/messenger": "5.4.*",
        "symfony/mime": "5.4.*",
        "symfony/monolog-bundle": "^3.5",
        "symfony/redis-messenger": "5.4.*",
        "symfony/runtime": "5.4.*",
        "symfony/serializer": "5.4.*",
        "symfony/translation": "5.4.*",
        "symfony/twig-bundle": "5.4.*",
        "symfony/validator": "5.4.*",
        "symfony/yaml": "5.4.*",
        "twig/twig": "^3.3"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.3",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "@stable",
        "phpunit/phpunit": "^9.5",
        "symfony/browser-kit": "5.4.*",
        "symfony/maker-bundle": "^1.29",
        "symfony/phpunit-bridge": "5.4.*",
        "symfony/stopwatch": "5.4.*",
        "symfony/web-profiler-bundle": "5.4.*"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "build:clear": [
            "rm -f .env*.local",
            "rm -f .env.local.php"
        ],
        "build:dev": [
            "@build:clear",
            "@composer install",
            "@composer dumpautoload --no-interaction",
            "bin/console secrets:decrypt-to-local --env=dev",
            "@composer dump-env dev",
            "bin/console cache:clear --env=dev"
        ],
        "build:prod": [
            "@build:clear",
            "@composer install",
            "@composer dumpautoload --no-interaction --no-dev --classmap-authoritative",
            "bin/console secrets:decrypt-to-local --env=prod",
            "@composer dump-env prod",
            "bin/console cache:clear --env=prod",
            "bin/console cache:warmup --env=prod"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "php:cs": "./vendor/bin/php-cs-fixer fix",
        "php:md": "./vendor/bin/phpmd . ansi phpmd.xml",
        "php:phpstan": "./vendor/bin/phpstan analyse --memory-limit=1G",
        "security:check": "symfony security:check",
        "php:quality": [
            "@php:cs",
            "@php:md",
            "@php:phpstan",
            "@security:check"
        ],
        "test:prepare": "cp .env.dev.local .env.test.local",
        "test": [
            "@test:prepare",
             "./bin/phpunit"
        ],
        "test:cov": [
            "@test:prepare",
            "./bin/phpunit --coverage-html ./coverage"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "5.4.*"
        }
    }
}
