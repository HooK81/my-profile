{
    "type": "project",
    "name": "hook81/my_profile_api",
    "description": "My Profile API",
    "version": "1.0.0",
    "license": "proprietary",
    "keywords": [
        "profile",
        "resume",
        "cv"
      ],
    "require": {
        "php": "^7.4.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "friendsofsymfony/jsrouting-bundle": "^2.5",
        "friendsofsymfony/rest-bundle": "^3.0",
        "jms/serializer-bundle": "^3.5",
        "lexik/jwt-authentication-bundle": "^2.6",
        "ramsey/uuid": "^3.9",
        "sensio/framework-extra-bundle": "^5.5",
        "symfony/console": "4.4.*",
        "symfony/dotenv": "4.4.*",
        "symfony/error-handler": "4.4.*",
        "symfony/flex": "^1.3.1",
        "symfony/framework-bundle": "4.4.*",
        "symfony/http-client": "4.4.*",
        "symfony/monolog-bundle": "^3.5",
        "symfony/swiftmailer-bundle": "^3.4",
        "symfony/translation": "4.4.*",
        "symfony/twig-bundle": "4.4.*",
        "symfony/yaml": "4.4.*",
        "twig/twig": "^3.3"
    },
    "require-dev": {
        "symfony/profiler-pack": "^1.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
        "build-clear": [
            "rm -f .env*.local",
            "rm -f .env.local.php"
        ],
        "build-dev": [
            "@build-clear",
            "@composer install",
            "@composer dumpautoload --no-interaction",
            "bin/console secrets:decrypt-to-local --env=dev",
            "@composer dump-env dev",
            "bin/console cache:clear --env=dev"
        ],
        "build-prod": [
            "@build-clear",
            "@composer install",
            "@composer dumpautoload --no-interaction --no-dev --classmap-authoritative",
            "bin/console secrets:decrypt-to-local --env=prod",
            "@composer dump-env prod",
            "bin/console cache:clear --env=prod",
            "bin/console cache:warmup --env=prod",
            "chmod 777 -R var"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "4.4.*"
        }
    }
}
