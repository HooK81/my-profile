{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "strictPropertyInitialization": false,
    "strict": true,
    "paths": {
      "my-profile-shared": ["../../libs/shared/dist"],
      "my-profile-shared/*": ["../../libs/shared/dist/*"]
    },
    "types": [
      "vitest/globals"
    ]
  }
}
