{
  "name": "my_profile_ui",
  "version": "1.2.2",
  "author": "Julien CROCHET",
  "description": "My Profile UI",
  "keywords": [
    "profile",
    "resume",
    "cv"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:HooK81/my-profile"
  },
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "install:clean": "rm -rf node_modules/ && rm -rf yarn.lock && rm -rf yarn-error.log && rm -rf build && rm -rf coverage && yarn install && yarn start"
  },
  "types": "types/index.d.ts",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.1",
    "@types/lodash": "^4.14.149",
    "@types/react-redux": "^7.1.7",
    "@types/react-router-dom": "^5.1.3",
    "axios": "^0.19.2",
    "flag-icon-css": "^3.5.0",
    "i18next": "^19.1.0",
    "i18next-browser-languagedetector": "^6.0.1",
    "i18next-xhr-backend": "^3.2.2",
    "js-sha256": "^0.9.0",
    "lodash": "^4.17.15",
    "moment": "^2.24.0",
    "node-sass": "^4.14.1",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-ga": "^3.1.2",
    "react-google-recaptcha": "^2.1.0",
    "react-highlight-words": "^0.16.0",
    "react-i18next": "^11.3.2",
    "react-redux": "^7.1.3",
    "react-router-dom": "^5.1.2",
    "react-router-hash-link": "^2.0.0",
    "react-scripts": "^3.4.1",
    "react-scroll": "^1.8.1",
    "react-toastify": "^5.5.0",
    "redux": "^4.0.5",
    "redux-devtools-extension": "^2.13.8",
    "redux-thunk": "^2.3.0",
    "style-it": "^2.1.4",
    "uuid": "^3.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.11.4",
    "dotenv": "^8.2.0",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.3",
    "redux-mock-store": "^1.5.4"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "proxy": "http://nginx/",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "optionalDependencies": {
    "typescript": "3.5.3"
  },
  "prettier": {
    "tabWidth": 2,
    "trailingComma": "all",
    "semi": true,
    "singleQuote": true,
    "printWidth": 120
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "./node_modules/",
      "constants.js",
      "selectors.js",
      "src/utils/configureStore.js",
      "src/utils/serviceWorker.js",
      "src/utils/ga.js",
      "src/api/index.js",
      "src/api/routing/",
      "src/index.js"
    ]
  }
}
