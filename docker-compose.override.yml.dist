version: '3.7'
services: 

    php:
        user: ${LOCAL_USER}
        volumes: 
            - './apps/api/:/usr/src/api'
            - './docker/users:/usr/src/api/resources/users:ro'
        environment:
            HOME: /home/user
            #XDEBUG_CONFIG: discover_client_host=true client_host=192.168.X.Y

    nginx:
        volumes: 
            - './apps/api/public/:/usr/src/api'

    # Node container used only for dev
    node:
        build: 
            context: .
            dockerfile: docker/node/Dockerfile
        image: myprofile_node:${TAG}
        container_name: mp_node
        user: ${LOCAL_USER}
        restart: "no"
        volumes:
            - './apps/front/:/usr/src/front'
        ports: 
            - '${NODE_DEV_PORT}:3000'
        environment:
            HOME: /home/user
        stdin_open: true # Interactive stdin for yarn start
        tty: true
        command: sh -c "yarn install && yarn start"
