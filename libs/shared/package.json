{
  "name": "my-profile-shared",
  "version": "5.3.1",
  "description": "Shared API contracts (Zod schemas, TypeScript types, OpenAPI spec)",
  "author": "Julien Crochet <julien@crochet.me>",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.mjs",
      "require": "./dist/fixtures/index.cjs"
    },
    "./fixtures/profile.fixtures": {
      "types": "./dist/fixtures/profile.fixtures.d.ts",
      "import": "./dist/fixtures/profile.fixtures.mjs",
      "require": "./dist/fixtures/profile.fixtures.cjs"
    }
  },
  "scripts": {
    "build": "tsc -noEmit && vite build",
    "tsc": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "fishery": "^2.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
