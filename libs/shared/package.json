{
  "name": "my-profile-shared",
  "version": "6.1.1",
  "description": "Shared API contracts (Zod schemas, TypeScript types, OpenAPI spec)",
  "author": "Julien Crochet <julien@crochet.me>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "import": "./dist/fixtures/index.mjs"
    },
    "./fixtures/profile.fixtures": {
      "types": "./src/fixtures/profile.fixtures.ts",
      "import": "./dist/fixtures/profile.fixtures.mjs"
    }
  },
  "scripts": {
    "build": "tsc -noEmit && vite build",
    "tsc": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "fishery": "^2.4.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
