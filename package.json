{
  "name": "my-profile",
  "version": "6.1.0",
  "private": true,
  "license": "MIT",
  "author": "Julien Crochet <julien@crochet.me>",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "nx": {
    "includedScripts": []
  },
  "scripts": {
    "build": "nx run-many -t build",
    "serve": "nx run-many -t serve --output-style=stream",
    "graph": "nx graph",
    "reset": "rm -rf node_modules apps/*/node_modules libs/*/node_modules; npm install; npx nx reset; npm run build",
    "test": "nx run-many -t test",
    "test:cov": "nx run-many -t test:cov",
    "lint": "nx run-many -t lint",
    "tsc": "nx run-many -t tsc",
    "prepare": "husky",
    "release": "nx release --skip-publish",
    "release:dry": "nx release --dry-run --skip-publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nx/js": "^23.1.1",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.0.2",
    "nx": "23.1.1"
  },
  "overrides": {
    "nx": {
      "brace-expansion": "5.0.9"
    },
    "preview-email": {
      "mailparser": "3.9.15"
    }
  },
  "volta": {
    "node": "24.19.0"
  }
}
